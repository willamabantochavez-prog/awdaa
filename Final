-- ==============================
-- SkyView
-- ==============================
pcall(function()
    local Lighting = game:GetService("Lighting")

    local REQUESTED_FOV = 180
    local ROBLOX_MAX_FOV = 120
    local SKY_BLUE = Color3.fromRGB(190, 225, 255)
    local SOFT_BLUE = Color3.fromRGB(170, 215, 255)

    local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
    if not atmosphere then
        atmosphere = Instance.new("Atmosphere")
        atmosphere.Parent = Lighting
    end

    local function applySkyView()
        local camera = workspace.CurrentCamera
        if camera then
            camera.FieldOfView = math.min(REQUESTED_FOV, ROBLOX_MAX_FOV)
        end

        atmosphere.Color = SKY_BLUE
        atmosphere.Decay = SOFT_BLUE
        atmosphere.Density = 0.22
        atmosphere.Glare = 0.12
        atmosphere.Haze = 0.35

        Lighting.Ambient = Color3.fromRGB(155, 205, 240)
        Lighting.OutdoorAmbient = Color3.fromRGB(185, 220, 250)
    end

    applySkyView()

    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        task.wait()
        pcall(applySkyView)
    end)

    print("[LOADER] ✅ SkyView ejecutado")
end)

task.wait(0.3)

-- ==============================
-- Speed Indicator
-- ==============================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local speedLabel = nil

local function setupSpeedIndicator(character)
    local oldGui = player.PlayerGui:FindFirstChild("EclipseSpeedGui")
    if oldGui then oldGui:Destroy() end

    local head = character:WaitForChild("Head", 5)
    if not head then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "EclipseSpeedGui"
    bb.Size = UDim2.new(0, 160, 0, 44)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = head
    bb.Parent = player.PlayerGui

    speedLabel = Instance.new("TextLabel")
    speedLabel.Size = UDim2.new(1, 0, 0.55, 0)
    speedLabel.BackgroundTransparency = 1
    speedLabel.Text = "Speed: 0"
    speedLabel.TextColor3 = Color3.fromRGB(255, 200, 140)
    speedLabel.Font = Enum.Font.GothamBlack
    speedLabel.TextScaled = true
    speedLabel.TextStrokeTransparency = 0
    speedLabel.TextStrokeColor3 = Color3.fromRGB(30, 15, 0)
    speedLabel.Parent = bb

    local discordLabel = Instance.new("TextLabel")
    discordLabel.Size = UDim2.new(1, 0, 0.45, 0)
    discordLabel.Position = UDim2.new(0, 0, 0.55, 0)
    discordLabel.BackgroundTransparency = 1
    discordLabel.Text = "dc.gg/eclipse.vs"
    discordLabel.TextColor3 = Color3.fromRGB(255, 200, 140)
    discordLabel.Font = Enum.Font.GothamBlack
    discordLabel.TextScaled = true
    discordLabel.TextStrokeTransparency = 0
    discordLabel.TextStrokeColor3 = Color3.fromRGB(30, 15, 0)
    discordLabel.Parent = bb

    print("[LOADER] ✅ Speed Indicator configurado")
end

player.CharacterAdded:Connect(function(character)
    task.wait(0.5)
    setupSpeedIndicator(character)
end)

if player.Character then
    setupSpeedIndicator(player.Character)
end

RunService.Heartbeat:Connect(function()
    pcall(function()
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local velocity = hrp.AssemblyLinearVelocity or hrp.Velocity
            local speed = math.floor(Vector3.new(velocity.X, 0, velocity.Z).Magnitude)
            if speedLabel and speedLabel.Parent then
                speedLabel.Text = "Speed: " .. speed
            end
        end
    end)
end)

